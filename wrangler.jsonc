{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poolworld-crm-web",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "dist",

    "not_found_handling": "single-page-application"
  }
}
